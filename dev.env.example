# Outage Tracker local development settings.
#
# Copy to .secrets/dev.env (git-ignored) and fill in what you need. Every
# setting is OPTIONAL: with an empty file the app runs against a seeded
# in-memory store, which is enough to develop and demo the whole product.
#
#   mkdir .secrets && cp dev.env.example .secrets/dev.env
#
# Not a .env file on purpose: the Cloudflare build copies every .env file it
# finds into the deployed Worker. `npm run dev` loads this one instead.
#
# The live site does not read this file. Its settings are Worker secrets and
# the "vars" in wrangler.jsonc; see SETUP.md.

# ---------------------------------------------------------------------------
# Database (optional) — switches the app from demo data to real, durable data,
# and turns on accounts. A Neon connection string for the dev branch, owner
# role, direct (not pooled) host:
#
#   npx neonctl@latest connection-string dev --project-id <id> --org-id <org>
#
# Then create the schema with `npm run db:migrate`.
# ---------------------------------------------------------------------------
DATABASE_URL=

# Sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Push notifications (optional).
#
# Generate a key pair with:  npx web-push generate-vapid-keys
# Without these, the alerts section of Settings explains that push is
# unavailable instead of offering a switch that cannot work.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/you/your-repo

# ---------------------------------------------------------------------------
# Public-data ingestion (optional).
#
# /api/ingest polls the registered feeds and writes what they return. It is
# refused entirely unless CRON_SECRET is set; on the live site the Cron Trigger
# sends it. Run it by hand with:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/ingest
#
# Generate a secret with:  openssl rand -base64 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# Sent to the National Weather Service, which refuses requests without a
# contactable User-Agent. Defaults to the repository URL.
NWS_USER_AGENT=

# Cloudflare Radar's internet outage annotations — curated events with a stated
# cause (cable cut, power outage, government action). Free: create a custom
# token at https://dash.cloudflare.com/profile/api-tokens with the permission
# Account > Radar > Read. Without it that one source is skipped and every other
# feed runs as normal.
CLOUDFLARE_RADAR_TOKEN=

# ---------------------------------------------------------------------------
# Rate limiting (optional, recommended in production).
#
# Client addresses are hashed before being used as rate-limit bucket keys and
# are never stored in the clear. A private salt stops those hashes from being
# guessable for a known address.
# ---------------------------------------------------------------------------
RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Basemap (optional). Read at build time.
#
# Defaults to OpenFreeMap, which needs no account and has no request quota.
# Any MapLibre-compatible style URL works here — including a Mapbox style, if
# you would rather use one.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_STYLE_URL_DARK=

# ---------------------------------------------------------------------------
# Geocoding (optional).
#
# Defaults to the public Nominatim instance. Its usage policy caps request
# rates and asks for an identifying User-Agent, so point this at a self-hosted
# instance or a commercial geocoder before you carry real traffic.
# ---------------------------------------------------------------------------
NOMINATIM_BASE_URL=
GEOCODER_USER_AGENT=
# Comma-separated ISO country codes to restrict search results. Default: us
GEOCODER_COUNTRY_CODES=
