# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. None are used: the Cloudflare build copies every .env file it
# finds into the deployed Worker, so local settings live in .secrets/dev.env.
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# Local credentials and dev settings (never commit)
/.secrets/

# Cloudflare build output and local state
/.open-next/
/.wrangler/
.dev.vars*
